{
  "name": "privhub-deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "私域枢纽 PrivHub 部署包：底座(@deepseek-ai/dsh 系列) + 私有插件组(privhub-core/auth/files/trash/admin)",
  "scripts": {
    "start": "node --import tsx/esm node_modules/@deepseek-ai/dsh/lib/bin.js --profile privhub --port 3181"
