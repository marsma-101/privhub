  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-base": "0.1.0-rc.7",
    "@deepseek-ai/dsh-web-app": "0.1.0-rc.7",
    "privhub-core": "file:./privhub-app/plugins/privhub-core",
    "privhub-auth": "file:./privhub-app/plugins/privhub-auth",
    "privhub-files": "file:./privhub-app/plugins/privhub-files",
    "privhub-trash": "file:./privhub-app/plugins/privhub-trash",
    "privhub-admin": "file:./privhub-app/plugins/privhub-admin",
    "tsx": "^4.22.4"
  }
}
