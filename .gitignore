# ===== 依赖与构建产物 =====
node_modules/
*.tsbuildinfo

# ===== 被锁定的清理残留（重启后可删） =====
.locked-leftovers/

# ===== 运行时数据（不进版本控制） =====
data-files/
.workbuddy/
**/sessions.json
**/trash.json
**/.trash/

# ===== 便携 node 运行时 =====
node-runtime/

# ===== 参考代码（第三方开源项目副本，只读参考，不进 git） =====
references/

# ===== 与运行无关的临时产物（不进 git，也不上 GitHub） =====
# 重构前完整快照（2GB，仅供本地查阅，不进 git）
_archive/
# 部署包（构建产物，由 scripts/build-deploy.ps1 随时重建）
deploy/
# 验收/验证截图（统一放 screenshots/；根目录散落的 png 也一律忽略）
screenshots/
/*.png
# 一次性清理工具（junction 删除脚本）
clean_junctions.cjs
# 临时/一次性测试脚本（根目录 tests/ 不进 git）
# 注意：privhub/tests/ 是【交付物】（回归套件），必须进版本控制，
# 因此这里用前导斜杠锚定到仓库根，不能写成 tests/（那会连 privhub/tests/ 一起忽略）。
/tests/
# 回归套件运行期产物（隔离测试根）
privhub/tests/.testroot/
privhub/tests/.audittest/
privhub/tests/.firstrun/
# 备份文件（含账号数据的旧快照）
*.bak*

# ===== 目录分工 =====
# docs/            设计文档（进 git，不上 GitHub）
# /tests/          根目录临时测试脚本（不进 git）
# privhub/tests/   回归套件（**进 git**，属交付物）
# screenshots/     截图（不进 git）

# ===== 杂项/构建产物（不进 git） =====
# 误输出到根目录的数字文件
/0
# 部署压缩包（构建产物，由部署脚本随时重建）
deploy.zip

# ===== 运行期账号/会话数据（首次启动自动生成种子账号，不进 git） =====
privhub/privhub-app/data/
privhub-work/privhub-app/data/

# ===== privhub 底座自带内容（从 DSH 复制，非本项目自有代码，不纳入版本控制） =====
# 底座已整体移入 privhub/engine/，旧路径 privhub/packages 等规则已失效
privhub/engine/
